meta {
  name: Fund Card
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/card/fund
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 100000
  }
}

docs {
  Fund the collateral account via the Rain cards API. The server reads the API
  key and contract id from its environment (`API_KEY` / `COLLATERAL_CONTRACT_ID`);
  the request only supplies the `amount`.
}
