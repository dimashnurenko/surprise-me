meta {
  name: Partner Checkout
  type: http
  seq: 6
}

post {
  url: {{partnerBaseUrl}}/api/checkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cardId": "a75df5f9-aba4-42cd-9471-4f0f726d8275",
    "amount": 500,
    "currency": "USD",
    "merchantName": "Coffee Shop",
    "merchantCategoryCode": "5814",
    "shippingAddress": {
      "line1": "221B Baker Street",
      "city": "New York",
      "state": "NY",
      "zip": "10001",
      "country": "US"
    }
  }
}

docs {
  Partner-side checkout. Given a scoped card the buyer platform already issued, the
  partner processes the transaction (authorizes the card through the Rain simulate
  API) and settles the order, then builds an order JSON — including the shipping
  address — and logs it (nothing is persisted yet). Served by the partner server
  (`python -m partner_mock.server`, port 8000), not the gift-agent API.
}
