meta {
  name: Scoped Card
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/card/scoped
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount_in_usd_cents": 4299
  }
}

docs {
  Issue a single-use scoped card via the Rain issuing API. The server reads the
  API key and user id from its environment (`API_KEY` / `USER_ID`) and encrypts
  a plaintext session id into the `sessionid` header using
  `SESSION_ID_CRYPTO_PUBLIC_KEY`. If the request omits `session_id`, the server
  auto-generates a fresh one (current Unix time in ms). You may still pass a
  plaintext `session_id`, or `encrypted_session_id` with an already-encrypted
  value, to override.
}
