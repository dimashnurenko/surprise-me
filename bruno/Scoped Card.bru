meta {
  name: Scoped Card
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/card/scoped
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount_in_usd_cents": 4299
  }
}

docs {
  Issue a single-use scoped card via the Rain issuing API. The server reads the
  API key and user id from its environment (`API_KEY` / `USER_ID`) and mints a
  fresh, encrypted session id for every request (using
  `SESSION_ID_CRYPTO_PUBLIC_KEY`) for the `sessionid` header. The client only
  supplies `amount_in_usd_cents` (and optionally `user_id`).
}
